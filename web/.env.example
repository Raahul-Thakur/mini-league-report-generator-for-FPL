# Server-side only: where the FastAPI backend runs. The site's /api/leagues/* route
# proxies there, so the browser never calls the API directly.
API_URL=http://127.0.0.1:8000

# Server-side only: shared secret, must equal the API's INTERNAL_API_KEY.
# Generate one with: openssl rand -hex 32   (leave empty for local dev)
INTERNAL_API_KEY=

# Public URL of this site, used for absolute link-preview (Open Graph) URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Branding (keep in sync with the API's BRAND_* vars so the site matches the cards)
NEXT_PUBLIC_SITE_NAME=Mini-League Report
NEXT_PUBLIC_INSTAGRAM_HANDLE=@your_handle
NEXT_PUBLIC_BRAND_PRIMARY=#FF5A36
NEXT_PUBLIC_BRAND_ACCENT=#FFC83D

# Analytics: Plausible is enabled only when the domain is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: your Plausible script URL (self-hosted or a site-specific script)
NEXT_PUBLIC_PLAUSIBLE_SRC=
